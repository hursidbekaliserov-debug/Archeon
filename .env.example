# NaqshLab Environment Configuration

NODE_ENV=development
PORT=3000

# Brand Configuration (Single Source of Truth)
BRAND_NAME=NaqshLab

# Database (PostgreSQL 16 in production/docker; SQLite file for local standalone testing)
DATABASE_URL="file:./dev.db"

# Internal Geometry Worker URL
WORKER_URL="http://127.0.0.1:8000"

# Redis (BullMQ queues)
REDIS_URL="redis://127.0.0.1:6379"

# S3 Compatible Storage (MinIO or AWS)
S3_ENDPOINT="http://127.0.0.1:9000"
S3_BUCKET="naqshlab-assets"
S3_ACCESS_KEY="naqshlab_minio"
S3_SECRET_KEY="naqshlab_minio_secret"
S3_USE_SSL=false

# Mail / Notifications (Mailpit in development)
SMTP_HOST="127.0.0.1"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@naqshlab.uz"

# Security Secrets
SESSION_SECRET="naqshlab_development_session_secret_min32chars_key!"
ED25519_MASTER_KEY="naqshlab_master_encryption_key_for_private_keys!"

# Optional AI Assistant (OFF by default)
ALLOW_EXTERNAL_AI=false
GEMINI_API_KEY=""
