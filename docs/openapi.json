  "components": {
    "schemas": {
      "DeltaERequest": {
        "properties": {
          "lab1": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Lab1",
            "description": "[L, a, b] point 1"
          },
          "lab2": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Lab2",
            "description": "[L, a, b] point 2"
          },
          "kl": {
            "type": "number",
            "title": "Kl",
            "default": 1.0
          },
          "kc": {
            "type": "number",
            "title": "Kc",
            "default": 1.0
          },
          "kh": {
            "type": "number",
            "title": "Kh",
            "default": 1.0
          }
        },
        "type": "object",
        "required": [
          "lab1",
          "lab2"
        ],
        "title": "DeltaERequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse"
      },
      "ManualCalibrationRequest": {
        "properties": {
          "pt1": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Pt1"
          },
          "pt2": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Pt2"
          },
          "known_distance_mm": {
            "type": "number",
            "title": "Known Distance Mm"
          }
        },
        "type": "object",
        "required": [
          "pt1",
          "pt2",
          "known_distance_mm"
        ],
        "title": "ManualCalibrationRequest"
      },
      "PanelSplitRequest": {
        "properties": {
          "panel_width_mm": {
            "type": "number",
            "title": "Panel Width Mm"
          },
          "panel_length_mm": {
            "type": "number",
            "title": "Panel Length Mm"
          },
          "max_module_width_mm": {
            "type": "number",
            "title": "Max Module Width Mm",
            "default": 280.0
          },
          "max_module_length_mm": {
            "type": "number",
            "title": "Max Module Length Mm",
            "default": 160.0
          },
          "joint_gap_mm": {
            "type": "number",
            "title": "Joint Gap Mm",
            "default": 1.5
          }
        },
        "type": "object",
        "required": [
          "panel_width_mm",
          "panel_length_mm"
        ],
        "title": "PanelSplitRequest"
      },
      "ToolpathRequest": {
        "properties": {
          "width_mm": {
            "type": "number",
            "title": "Width Mm"
          },
          "length_mm": {
            "type": "number",
            "title": "Length Mm"
          },
          "relief_depth_mm": {
            "type": "number",
            "title": "Relief Depth Mm"
          },
          "tool_diameter_mm": {
            "type": "number",
            "title": "Tool Diameter Mm",
            "default": 3.175
          },
          "stepover_mm": {
            "type": "number",
            "title": "Stepover Mm",
            "default": 1.0
          },
          "stepdown_mm": {
            "type": "number",
            "title": "Stepdown Mm",
            "default": 1.5
          }
        },
        "type": "object",
        "required": [
          "width_mm",
          "length_mm",
          "relief_depth_mm"
        ],
        "title": "ToolpathRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
