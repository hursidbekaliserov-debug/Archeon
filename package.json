{
  "name": "naqshlab-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@naqshlab/web",
    "build": "npm run build --workspace=@naqshlab/shared && npm run build --workspace=@naqshlab/web",
    "start": "npm run start --workspace=@naqshlab/web",
    "postinstall": "npm run build --workspace=@naqshlab/shared && prisma generate --schema=apps/web/prisma/schema.prisma",
    "test": "npm run test --workspace=@naqshlab/web && .\\apps\\worker\\.venv\\Scripts\\pytest.exe apps/worker",
    "test:worker": ".\\apps\\worker\\.venv\\Scripts\\pytest.exe apps/worker",
    "test:web": "npm run test --workspace=@naqshlab/web",
    "test:e2e": "npx playwright test",
    "seed": "npm run seed --workspace=@naqshlab/web",
    "verify-audit": "npm run verify-audit --workspace=@naqshlab/web"
  },
  "devDependencies": {
    "next": "^14.2.15",
    "playwright": "^1.48.2",
    "prisma": "^5.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
